/* === Global Dark Theme === */
body {
  background-color: #0f1117;
  color: #e6e6e6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen;
  line-height: 1.7;
}

/* Main content area */
.page-content, .wrapper, main {
  max-width: 1100px;
  margin: auto;
  padding: 2rem;
}

/* Headings */
h1, h2, h3, h4 {
  color: #ffffff;
  margin-top: 2.5rem;
}

/* Accent color */
h1 {
  border-bottom: 2px solid #3b82f6;
  padding-bottom: 0.3rem;
}

/* Links */
a {
  color: #60a5fa;
  text-decoration: none;
}
a:hover {
  color: #93c5fd;
  text-decoration: underline;
}

/* Lists */
ul li {
  margin-bottom: 0.5rem;
}

/* Horizontal rule */
hr {
  border: none;
  border-top: 1px solid #2a2f3a;
  margin: 3rem 0;
}

/* Cards (experience & projects) */
section, article {
  background: #161b22;
  border-radius: 12px;
  padding: 1.5rem 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

/* Images */
img {
  max-width: 100%;
  border-radius: 10px;
  margin: 1.5rem 0;
}

/* Sidebar (if used) */
.sidebar {
  background: #161b22;
  border-right: 1px solid #2a2f3a;
  padding: 1.5rem;
}

.sidebar a {
  display: block;
  padding: 0.4rem 0;
  color: #c9d1d9;
}

.sidebar a:hover {
  color: #ffffff;
}

/* Footer */
footer {
  text-align: center;
  color: #9ca3af;
  padding: 2rem 0;
}
